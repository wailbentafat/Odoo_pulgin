<data>
    <record id="view_partner_form_balance" model="ir.ui.view">
        <field name="name">res.partner.form.balance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <xpath expr="." position="inside">
                    <style>
                        .balance-cards-container {
                            display: flex;
                            gap: 10px;
                            margin-bottom: 10px;
                        }
                        .balance-card {
                            flex: 1;
                            min-width: 200px;
                            max-height: 90px;
                            padding: 10px 12px;
                            border: 1px solid #ccc;
                            border-radius: 4px;
                            text-align: center;
                            background: #f8f9fa;
                            display: flex;
                            flex-direction: column;
                            justify-content: center;
                        }

                        .balance-card-label {
                            font-weight: bold;
                            font-size: 14px;
                            margin-bottom: 4px;
                        }
                        .balance-card-value {
                            font-size: 20px;
                            font-weight: bold;
                        }
                        .balance-card-subtitle {
                            font-size: 11px;
                            font-style: italic;
                            margin-top: 4px;
                            color: #888;
                        }
                        .balance-card-label {
                            font-weight: bold;
                            font-size: 12px;
                            margin-bottom: 2px;
                        }
                        .balance-card-value {
                            font-size: 16px;
                            font-weight: bold;
                        }
                        .balance-card-subtitle {
                            font-size: 10px;
                            font-style: italic;
                            margin-top: 2px;
                            color: #888;
                        }
                        @media (max-width: 768px) {
                            .balance-cards-container {
                                gap: 5px;
                                margin-bottom: 8px;
                            }
                            .balance-card {
                                min-width: 100px;
                                max-height: 80px;
                                padding: 8px 8px;
                            }
                            .balance-card-label {
                                font-size: 11px;
                                margin-bottom: 2px;
                            }
                            .balance-card-value {
                                font-size: 16px;
                            }
                            .balance-card-subtitle {
                                font-size: 9px;
                                margin-top: 2px;
                            }
                        }
                        @media (max-width: 480px) {
                            .balance-cards-container {
                                gap: 4px;
                            }
                            .balance-card {
                                min-width: 80px;
                                max-height: 70px;
                                padding: 6px 4px;
                            }
                            .balance-card-label {
                                font-size: 10px;
                            }
                            .balance-card-value {
                                font-size: 13px;
                            }
                            .balance-card-subtitle {
                                font-size: 8px;
                            }
                        }
                    </style>
                </xpath>
                <div class="balance-cards-container">
                    <div class="balance-card">
                        <div class="balance-card-label">Solde Fournisseur</div>
                        <div class="balance-card-value">
                            <field name="solde_fournisseur" decoration-danger="solde_fournisseur &gt; 0" decoration-success="solde_fournisseur &lt;= 0"/>
                        </div>
                        <div class="balance-card-subtitle">
                            <field name="label_solde_fournisseur"/>
                        </div>
                    </div>
                    <div class="balance-card">
                        <div class="balance-card-label">Solde Client</div>
                        <div class="balance-card-value">
                            <field name="solde_client" decoration-danger="solde_client &gt; 0" decoration-success="solde_client &lt;= 0"/>
                        </div>
                        <div class="balance-card-subtitle">
                            <field name="label_solde_client"/>
                        </div>
                    </div>
                    <div class="balance-card">
                        <div class="balance-card-label">Balance</div>
                        <div class="balance-card-value">
                            <field name="total_balance" decoration-danger="total_balance &gt; 0" decoration-success="total_balance &lt;= 0"/>
                        </div>
                        <div class="balance-card-subtitle">Total</div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</data>
